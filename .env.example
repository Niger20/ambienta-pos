# Copiar a .env en la raíz. Conectar una base PostgreSQL externa ya preparada.
POSTGRES_URL=postgresql://usuario:password@host:5432/ambienta_pos
# Generar el secreto JWT:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SEED=

API_PORT=3000
# Agregar el origen público si se publica; separar varios orígenes por comas.
ALLOWED_ORIGINS=http://localhost:3000
# API_IMAGE permite cambiar la etiqueta de la imagen local (opcional).
# La configuración de producción se define en Railway, no en este archivo.
