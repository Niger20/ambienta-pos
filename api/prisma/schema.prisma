generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model abonos {
  abonoid          Int              @id @default(autoincrement())
  cuentaid         Int
  fecha            DateTime?        @default(now()) @db.Timestamp(6)
  monto            Decimal          @db.Decimal(10, 2)
  metodopago       String           @db.VarChar(50)
  cuentasporcobrar cuentasporcobrar @relation(fields: [cuentaid], references: [cuentaid], onDelete: NoAction, onUpdate: NoAction)
  devoluciones     devoluciones[]
}

model categoriasproductos {
  categoriaid Int         @id @default(autoincrement())
  nombre      String      @db.VarChar(100)
  descripcion String?
  productos   productos[]

  // Una subcategoría es una categoría que apunta a su categoría padre.
  categoriapadreid Int?
  padre            categoriasproductos?  @relation("CategoriaSubcategorias", fields: [categoriapadreid], references: [categoriaid], onDelete: NoAction, onUpdate: NoAction, map: "categoriasproductos_padre_fkey")
  subcategorias    categoriasproductos[] @relation("CategoriaSubcategorias")

  @@index([categoriapadreid], map: "idx_categorias_padre")
}

model clientes {
  clienteid           Int                 @id @default(autoincrement())
  categoriaclienteid  Int?
  nombre              String              @db.VarChar(100)
  tipocliente         String              @default("NATURAL") @db.VarChar(20)
  cedula              String?             @unique @db.VarChar(20)
  ruc                 String?             @unique @db.VarChar(20)
  telefono            String?             @db.VarChar(15)
  direccion           String?
  ubicaciongeografica String?             @db.VarChar(255)
  limitecredito       Decimal?            @db.Decimal(10, 2)
  categoriasclientes  categoriasclientes? @relation(fields: [categoriaclienteid], references: [categoriaclienteid], onDelete: NoAction, onUpdate: NoAction)
  cuentasporcobrar    cuentasporcobrar[]
  ventas              ventas[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model compras {
  compraid                 Int                        @id @default(autoincrement())
  proveedorid              Int
  ordencompraid            Int?
  fecha                    DateTime?                  @default(now()) @db.Timestamp(6)
  total                    Decimal                    @db.Decimal(10, 2)
  metodopago               String                     @db.VarChar(50)
  tipocompra               String                     @db.VarChar(50)
  estado                   Boolean                    @default(true)
  facturaproveedor         String?                    @db.VarChar(100)
  ordenescompra            ordenescompra?             @relation(fields: [ordencompraid], references: [ordencompraid], onDelete: NoAction, onUpdate: NoAction)
  proveedores              proveedores                @relation(fields: [proveedorid], references: [proveedorid], onDelete: NoAction, onUpdate: NoAction)
  comprasproductos         comprasproductos[]
  costosadicionalescompras costosadicionalescompras[]
  cuentasporpagar          cuentasporpagar[]
  movimientoscompras       movimientoscompras[]

  @@index([fecha], map: "idx_compras_fecha")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model comprasproductos {
  compraid       Int
  productoid     Int
  cantidad       Decimal   @db.Decimal(10, 2)
  preciounitario Decimal   @db.Decimal(10, 2)
  descuento      Decimal?  @default(0) @db.Decimal(10, 2)
  totalproducto  Decimal?  @default(dbgenerated("((preciounitario * cantidad) - descuento)")) @db.Decimal(10, 2)
  numerolote     String?   @db.VarChar(50)
  compras        compras   @relation(fields: [compraid], references: [compraid], onDelete: NoAction, onUpdate: NoAction)
  productos      productos @relation(fields: [productoid], references: [productoid], onDelete: NoAction, onUpdate: NoAction)

  @@id([compraid, productoid])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model cuentasporcobrar {
  cuentaid         Int      @id @default(autoincrement())
  ventaid          Int
  clienteid        Int
  montototal       Decimal  @db.Decimal(10, 2)
  montopagado      Decimal? @default(0) @db.Decimal(10, 2)
  montorestante    Decimal? @default(dbgenerated("(montototal - montopagado)")) @db.Decimal(10, 2)
  fechavencimiento DateTime @db.Date
  estado           String   @db.VarChar(50)
  abonos           abonos[]
  clientes         clientes @relation(fields: [clienteid], references: [clienteid], onDelete: NoAction, onUpdate: NoAction)
  ventas           ventas   @relation(fields: [ventaid], references: [ventaid], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model cuentasporpagar {
  cuentapagarid       Int                   @id @default(autoincrement())
  compraid            Int
  montototal          Decimal               @db.Decimal(10, 2)
  montopagado         Decimal?              @default(0) @db.Decimal(10, 2)
  montorestante       Decimal?              @default(dbgenerated("(montototal - montopagado)")) @db.Decimal(10, 2)
  cuotas              Int?
  montocuota          Decimal?              @db.Decimal(10, 2)
  fechacuota          Int?
  fechavencimiento    DateTime              @db.Date
  estado              String                @db.VarChar(50)
  compras             compras               @relation(fields: [compraid], references: [compraid], onDelete: NoAction, onUpdate: NoAction)
  pagocuentasporpagar pagocuentasporpagar[]
}

model deliveries {
  deliveryid       Int             @id @default(autoincrement())
  repartidorid     Int
  fecha            DateTime?       @default(now()) @db.Timestamp(6)
  direccionentrega String
  costo            Decimal         @db.Decimal(10, 2)
  estado           Boolean?
  repartidores     repartidores    @relation(fields: [repartidorid], references: [repartidorid], onDelete: NoAction, onUpdate: NoAction)
  ventadelivery    ventadelivery[]
}

model empresa {
  empresaid     Int      @id @default(autoincrement())
  nombreempresa String?  @db.VarChar(100)
  direccion     String?
  telefono      String?  @db.VarChar(15)
  ruc           String?  @db.VarChar(50)
  logourl       String?  @db.VarChar(255)
  tasacambio    Decimal? @db.Decimal(10, 2)
}

model gastos {
  gastoid     Int          @id @default(autoincrement())
  usuarioid   Int
  nombre      String       @db.VarChar(100)
  descripcion String?
  usuarios    usuarios     @relation(fields: [usuarioid], references: [usuarioid], onDelete: NoAction, onUpdate: NoAction)
  pagogastos  pagogastos[]
}

model movimientoscompras {
  movimientocompraid    Int
  compraid              Int
  compras               compras               @relation(fields: [compraid], references: [compraid], onDelete: NoAction, onUpdate: NoAction)
  movimientosinventario movimientosinventario @relation(fields: [movimientocompraid], references: [movimientoid], onDelete: NoAction, onUpdate: NoAction)

  @@id([movimientocompraid, compraid])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model movimientosinventario {
  movimientoid       Int                  @id @default(autoincrement())
  productoid         Int
  tipomovimiento     String               @db.VarChar(50)
  cantidad           Decimal              @db.Decimal(10, 2)
  numerolote         String?              @db.VarChar(50)
  stockanterior      Decimal              @db.Decimal(10, 2)
  stockresultante    Decimal?             @default(dbgenerated("(stockanterior + cantidad)")) @db.Decimal(10, 2)
  fecha              DateTime?            @default(now()) @db.Timestamp(6)
  motivo             String?
  mermasEgreso       mermas[]             @relation("MermaMovimientoEgreso")
  mermasIngreso      mermas[]             @relation("MermaMovimientoIngreso")
  movimientoscompras movimientoscompras[]
  productos          productos            @relation(fields: [productoid], references: [productoid], onDelete: NoAction, onUpdate: NoAction)
  movimientoventas   movimientoventas[]

  @@index([productoid], map: "idx_movinventario_producto")
}

model movimientoventas {
  movimeintoventaid     Int
  ventaid               Int
  movimientosinventario movimientosinventario @relation(fields: [movimeintoventaid], references: [movimientoid], onDelete: NoAction, onUpdate: NoAction)
  ventas                ventas                @relation(fields: [ventaid], references: [ventaid], onDelete: NoAction, onUpdate: NoAction)

  @@id([movimeintoventaid, ventaid])
}

model pagocuentasporpagar {
  pagoid          Int
  cuentapagarid   Int
  cuentasporpagar cuentasporpagar @relation(fields: [cuentapagarid], references: [cuentapagarid], onDelete: NoAction, onUpdate: NoAction)
  pagos           pagos           @relation(fields: [pagoid], references: [pagoid], onDelete: NoAction, onUpdate: NoAction)

  @@id([pagoid, cuentapagarid])
}

model pagogastos {
  pagoid  Int
  gastoid Int
  gastos  gastos @relation(fields: [gastoid], references: [gastoid], onDelete: NoAction, onUpdate: NoAction)
  pagos   pagos  @relation(fields: [pagoid], references: [pagoid], onDelete: NoAction, onUpdate: NoAction)

  @@id([pagoid, gastoid])
}

model pagos {
  pagoid              Int                   @id @default(autoincrement())
  fecha               DateTime?             @default(now()) @db.Timestamp(6)
  monto               Decimal               @db.Decimal(10, 2)
  metodopago          String                @default("Efectivo") @db.VarChar(50)
  estado              Boolean?              @default(false)
  pagocuentasporpagar pagocuentasporpagar[]
  pagogastos          pagogastos[]
  devoluciones        devoluciones[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model productos {
  productoid               Int                      @id @default(autoincrement())
  codigobarra              String?                  @unique @db.VarChar(50)
  categoriaid              Int?
  unidadmedidaid           Int
  nombre                   String                   @db.VarChar(100)
  descripcion              String?
  preciocompra             Decimal                  @db.Decimal(10, 2)
  precioventa              Decimal                  @db.Decimal(10, 2)
  utilidad                 Decimal?                 @default(dbgenerated("(precioventa - preciocompra)")) @db.Decimal(10, 2)
  preciomayoreo            Decimal?                 @db.Decimal(10, 2)
  cantidadminimamayoreo    Decimal?                 @db.Decimal(10, 2)
  stockminimo              Decimal?                 @default(0) @db.Decimal(10, 2)
  stockactual              Decimal?                 @default(0) @db.Decimal(10, 2)
  requierefechavencimiento Boolean                  @default(false)
  fechavencimiento         DateTime?                @db.Date
  publicadoencatalogo      Boolean                  @default(false)
  comprasproductos         comprasproductos[]
  imagenesproductos        imagenesproductos[]
  mermasOrigen             mermas[]                 @relation("MermaProductoOrigen")
  mermasDestino            mermas[]                 @relation("MermaProductoDestino")
  movimientosinventario    movimientosinventario[]
  ordenescompraproductos   ordenescompraproductos[]
  categoriasproductos      categoriasproductos?     @relation(fields: [categoriaid], references: [categoriaid], onDelete: NoAction, onUpdate: NoAction)
  unidadesmedida           unidadesmedida           @relation(fields: [unidadmedidaid], references: [unidadmedidaid], onDelete: NoAction, onUpdate: NoAction)
  ventaproductos           ventaproductos[]
}

model proveedores {
  proveedorid         Int             @id @default(autoincrement())
  nombreempresa       String          @db.VarChar(100)
  asesorventas        String          @db.VarChar(100)
  telefono            String?         @db.VarChar(15)
  direccion           String?
  ubicaciongeografica String?         @db.VarChar(255)
  clasificacion       String?         @db.VarChar(50)
  compras             compras[]
  ordenescompra       ordenescompra[]
}

model repartidores {
  repartidorid Int          @id @default(autoincrement())
  nombre       String       @db.VarChar(100)
  telefono     String?      @db.VarChar(15)
  deliveries   deliveries[]
}

model sesiones {
  sesionid          Int       @id @default(autoincrement())
  usuarioid         Int
  fechainicio       DateTime? @default(now()) @db.Timestamp(6)
  fechafin          DateTime? @db.Timestamp(6)
  montoinicial      Decimal   @db.Decimal(10, 2)
  montofinalsistema Decimal?  @db.Decimal(10, 2)
  montofinalfisico  Decimal?  @db.Decimal(10, 2)
  usuarios          usuarios  @relation(fields: [usuarioid], references: [usuarioid], onDelete: NoAction, onUpdate: NoAction)
  ventas            ventas[]
}

model usuarios {
  usuarioid              Int                      @id @default(autoincrement())
  nombreusuario          String                   @unique @db.VarChar(50)
  contrasenahash         String                   @db.VarChar(255)
  fecharegistro          DateTime?                @default(now()) @db.Timestamp(6)
  rol                    String?                  @db.VarChar(50)
  anticipossalario       anticipossalario[]
  auditoria              auditoria[]
  devoluciones           devoluciones[]
  gastos                 gastos[]
  historialsalarios      historialsalarios[]
  liquidacionesempleados liquidacionesempleados[]
  mermas                 mermas[]
  pagosbeneficios        pagosbeneficios[]
  periodosplanilla       periodosplanilla[]
  prestamosempleados     prestamosempleados[]
  sesiones               sesiones[]
  solicitudesvacaciones  solicitudesvacaciones[]
}

model ventadelivery {
  ventaid    Int
  deliveryid Int
  deliveries deliveries @relation(fields: [deliveryid], references: [deliveryid], onDelete: NoAction, onUpdate: NoAction)
  ventas     ventas     @relation(fields: [ventaid], references: [ventaid], onDelete: NoAction, onUpdate: NoAction)

  @@id([ventaid, deliveryid])
}

